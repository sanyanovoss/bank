class Button:

    def __init__(self, window):

        button_style = {
            "width": 4,
            "height": 2,
            "font": ("Arial", 12),
        }

        positions = {
            "1": (155, 330),
            "2": (225, 330),
            "3": (295, 330),
            "4": (155, 380),
            "5": (225, 380),
            "6": (295, 380),
            "7": (155, 430),
            "8": (225, 430),
            "9": (295, 430),
            "0": (225, 480)
        }

        for number, position in positions.items():

            button = tk.Button(
                window,
                text=number,
                command=lambda n=number: self.number_click(n),
                **button_style
            )

            button.place(
                x=position[0],
                y=position[1]
            )

        self.buttonLogin = tk.Button(
            window,
            text="Підтвердити",
            command=self.login,
            width=12,
            height=2,
            font=("Arial", 11)
        )
        self.buttonLogin.place(x=375, y=330)

        self.buttonBalance = tk.Button(
            window,
            text="Баланс",
            command=self.show_balance,
            width=12,
            height=2,
            font=("Arial", 11)
        )
        self.buttonBalance.place(x=375, y=380)

        self.buttonTake = tk.Button(
            window,
            text="Снять",
            command=self.take_money,
            width=12,
            height=2,
            font=("Arial", 11)
        )
        self.buttonTake.place(x=375, y=430)

        self.buttonClear = tk.Button(
            window,
            text="Очистити",
            command=self.clear,
            width=12,
            height=2,
            font=("Arial", 11)
        )
        self.buttonClear.place(x=375, y=480)

        self.buttonBack = tk.Button(
            window,
            text="Вернуться",
            command=self.back,
            width=12,
            height=2,
            font=("Arial", 11)
        )
        self.buttonBack.place(x=375, y=530)

        self.buttonFinish = tk.Button(
            window,
            text="Завершить",
            command=self.finish,
            width=12,
            height=2,
            font=("Arial", 11)
        )
        self.buttonFinish.place(x=185, y=540)


    def number_click(self, number):

        if active_entry:
            active_entry.insert(tk.END, number)


    def login(self):

        global current_user
        global active_entry

        card_number = card_entry.get()
        pin = pin_entry.get()

        user = find_user(card_number)

        if user is None:
            status_label.config(
                text="Картку не знайдено",
                fg="red"
            )
            return

        if user.pin != pin:
            status_label.config(
                text="Неправильний PIN-код",
                fg="red"
            )
            return

        current_user = user

        card_label.place_forget()
        card_entry.place_forget()
        pin_label.place_forget()
        pin_entry.place_forget()
        status_label.place_forget()

        user_label.config(
            text=f"Користувач: {user.name}"
        )

        user_label.place(
            x=25,
            y=70
        )

        balance_label.config(
            text=f"Баланс: {user.balance} грн"
        )

        balance_label.place(
            x=25,
            y=110
        )

        active_entry = None


    def show_balance(self):

        if current_user is None:
            status_label.config(
                text="Спочатку увійдіть у рахунок",
                fg="red"
            )
            status_label.place(
                x=25,
                y=150
            )
            return

        balance_label.config(
            text=f"Баланс: {current_user.balance} грн"
        )


    def take_money(self):

        global active_entry

        if current_user is None:
            status_label.config(
                text="Спочатку увійдіть у рахунок",
                fg="red"
            )
            status_label.place(
                x=25,
                y=150
            )
            return

        amount_label.place(
            x=180,
            y=270
        )

        amount_entry.place(
            x=250,
            y=267
        )

        amount_entry.delete(0, tk.END)

        active_entry = amount_entry

        self.buttonTake.config(
            text="Підтвердити",
            command=self.confirm_take
        )


    def confirm_take(self):

        global active_entry

        amount_text = amount_entry.get()

        if not amount_text.isdigit():
            status_label.config(
                text="Введіть правильну суму",
                fg="red"
            )
            status_label.place(
                x=25,
                y=150
            )
            return

        amount = int(amount_text)

        if amount <= 0:
            status_label.config(
                text="Сума повинна бути більше 0",
                fg="red"
            )
            status_label.place(
                x=25,
                y=150
            )
            return

        if amount > current_user.balance:
            status_label.config(
                text="Недостатньо коштів",
                fg="red"
            )
            status_label.place(
                x=25,
                y=150
            )
            return

        current_user.balance -= amount

        transaction = Transaction(
            "Снятие",
            amount
        )

        transaction.show_transaction()

        balance_label.config(
            text=f"Баланс: {current_user.balance} грн"
        )

        amount_entry.delete(0, tk.END)
        amount_entry.place_forget()
        amount_label.place_forget()

        active_entry = None

        status_label.config(
            text=f"Знято {amount} грн",
            fg="green"
        )

        status_label.place(
            x=25,
            y=150
        )

        self.buttonTake.config(
            text="Снять",
            command=self.take_money
        )


    def back(self):

        global active_entry

        amount_entry.delete(0, tk.END)
        amount_entry.place_forget()
        amount_label.place_forget()

        active_entry = None

        status_label.config(text="")
        status_label.place_forget()

        self.buttonTake.config(
            text="Снять",
            command=self.take_money
        )


    def finish(self):

        global current_user
        global active_entry

        current_user = None
        active_entry = None

        amount_entry.delete(0, tk.END)
        amount_entry.place_forget()
        amount_label.place_forget()

        user_label.place_forget()
        balance_label.place_forget()

        card_entry.delete(0, tk.END)
        pin_entry.delete(0, tk.END)

        card_label.place(
            x=25,
            y=75
        )

        card_entry.place(
            x=135,
            y=73
        )

        pin_label.place(
            x=25,
            y=115
        )

        pin_entry.place(
            x=135,
            y=113
        )

        status_label.config(text="")
        status_label.place(
            x=25,
            y=150
        )

        self.buttonTake.config(
            text="Снять",
            command=self.take_money
        )


    def clear(self):

        global active_entry

        card_entry.delete(0, tk.END)
        pin_entry.delete(0, tk.END)
        amount_entry.delete(0, tk.END)

        status_label.config(text="")

        amount_entry.place_forget()
        amount_label.place_forget()

        active_entry = None


